generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  role          Role           @default(USER)
  consultations Consultation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

enum Role {
  USER
  DOCTOR
  ADMIN
}

model Generation {
  id            String   @id @default(uuid())
  url           String
  generatedCode String   @db.Text
  companyName   String?
  about         String?
  contactInfo   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Consultation {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  symptoms           String   @db.Text
  aiPrescription     Json?
  doctorPrescription Json?
  diagnosticTests    Json?
  status             Status   @default(PENDING)
  doctorComments     String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum Status {
  PENDING
  APPROVED
  REJECTED
}
